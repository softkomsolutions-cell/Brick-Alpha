{
  "name": "collecttrade",
  "private": true,
  "scripts": {
    "install:all": "npm --prefix frontend ci && npm --prefix server ci",
    "dev:frontend": "npm --prefix frontend run dev",
    "dev:server": "npm --prefix server run dev",
    "build": "npm --prefix frontend run build",
    "check": "npm --prefix frontend run lint && npm --prefix server run check",
    "partner:staging": "npm --prefix frontend run build && npm --prefix server start",
    "demo": "node scripts/start-demo.mjs",
    "partner:share": "node scripts/partner-share.mjs",
    "render:smoke": "node scripts/render-smoke-test.mjs",
    "test:backend": "npm --prefix server run test",
    "lint:frontend": "npm --prefix frontend run lint",
    "check:backend": "npm --prefix server run check",
    "check:full": "npm run test:backend && npm run lint:frontend && npm run check:backend && npm run build",
    "db:generate": "npm --prefix server run db:generate",
    "db:format": "npm --prefix server run db:format",
    "db:validate": "npm --prefix server run db:validate",
    "db:migrate:dev": "npm --prefix server run db:migrate:dev",
    "db:migrate:deploy": "npm --prefix server run db:migrate:deploy",
    "db:legacy:inspect": "npm --prefix server run db:legacy:inspect",
    "partner:compose": "docker compose up --build -d",
    "partner:compose:down": "docker compose down",
    "partner:compose:logs": "docker compose logs -f collecttrade"
  },
  "dependencies": {
    "localtunnel": "2.0.2"
  }
}
