# Optional Phase 1 PostgreSQL foundation
# Railway supplies this value in staging/production. The legacy JSON application
# remains active when DATABASE_URL is empty during the migration period.
DATABASE_URL=

# Phase 2 auth only. Defaults to legacy; never changes financial persistence.
AUTH_PERSISTENCE_MODE=legacy
# Required in staging/production (at least 32 random characters); never commit a value.
AUTH_SECRET=
# Only development/test can expose a reset code. Always ignored in deployed environments.
AUTH_RESET_DEMO_CODES=false
# Exact comma-separated frontend origins, e.g. the final Cloudflare HTTPS origin.
# Empty in staging/production denies all cross-origin browser access.
CORS_ALLOWED_ORIGINS=
# Optional exact trusted proxy IPs/CIDRs; leave empty locally. Do not use '*'.
TRUSTED_PROXY_CIDRS=

# LEGO beta market sources
BRICKECONOMY_API_KEY=
BRICKLINK_CONSUMER_KEY=
BRICKLINK_CONSUMER_SECRET=
BRICKLINK_TOKEN=
BRICKLINK_TOKEN_SECRET=

# Optional overrides
USD_ZAR_RATE=17.8
BRICKECONOMY_DAILY_BUDGET=100
BRICKECONOMY_RESERVE_PERCENT=15
BRICKLINK_DAILY_BUDGET=4500
BRICKLINK_RESERVE_PERCENT=15
